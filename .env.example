# Copy this file to .env for local development.
# The values below are development examples only. Never commit real secrets.

# MySQL 8.x
DB_HOST=localhost
DB_PORT=3306
DB_NAME=edums
DB_USERNAME=edums_app
DB_PASSWORD=edums_dev_password
DB_SSL_MODE=DISABLED

# Used later by Docker Compose to initialize the local MySQL container.
MYSQL_ROOT_PASSWORD=edums_root_dev_password

# Spring Boot
BACKEND_PORT=8080
APP_VERSION=0.0.1-SNAPSHOT
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8080
